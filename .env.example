# 이 파일을 .env.local로 복사해서 값을 바꿔 쓴다. (.env.local은 git에 올라가지 않는다)

# DB(wiki.db), 업로드 파일, 백업이 저장될 폴더. 상대 경로는 프로젝트 폴더 기준.
DATA_DIR=./data

# [M1 임시] true면 로그인 없이 문서를 편집할 수 있다. 서버는 이 PC(127.0.0.1)에서만 접속된다.
# M2에서 관리자 로그인이 생기면 이 설정은 없어진다.
WIKI_OPEN_EDIT=true

# 화면 상단과 브라우저 탭에 보이는 위키 이름 (50자 이하)
WIKI_NAME=개발 위키
